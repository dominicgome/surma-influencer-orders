# ---------- Shopify ----------
SHOPIFY_SHOP_DOMAIN=344a51-89.myshopify.com
SHOPIFY_API_VERSION=2025-10
# Dev Dashboard app (client credentials grant). Get the secret from the app's Settings page.
SHOPIFY_CLIENT_ID=1b09915b818b38109708d16c0b026884
SHOPIFY_CLIENT_SECRET=
# OPTIONAL: if you have a static Admin API token (shpat_...), set it and the two lines above are ignored
SHOPIFY_ADMIN_TOKEN=
