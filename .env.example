# ---------- Portal ----------
PORT=3000
# Shared portal password + secret used to sign login cookies (use a long random string)
PORTAL_PASSWORD=
SESSION_SECRET=
# Set to true once the portal is served over HTTPS
COOKIE_SECURE=false

# ---------- Guardrails ----------
MAX_ITEMS_PER_ORDER=6
MAX_QTY_PER_LINE=2
DISCOUNT_TITLE=INFLUENCER
# INFLUENCER appears only as the DISCOUNT title. Leave tag/note blank to keep orders clean.
ORDER_TAG=
ORDER_NOTE=
TRACKING_SYNC_MINUTES=30
